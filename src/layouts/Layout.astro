---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/Imagenes/Logotipo.webp" />
    <meta name="generator" content={Astro.generator} />
    <title>Proyecto Aplicacion Web</title>

    <slot name="head" />
  </head>
  <body class="bg-white text-gray-800">
    <!-- nota importante: se uso capacitor pero no leia las rutas, se tuvo que usar
    .html para que cuando compilara la aplicacion movil puediera abrir las
    diferentes paginas dentro del proyecto una vez se abriera en el celular -->
    <!-- Skeleton  -->
    <div id="skeleton_container">
      <div class="skeleton-skeleton-titele"></div>
      <div class="skeleton-skeleton-titele w-2/3"></div>
      <div class="skeleton-skeleton-titele"></div>
      <div class="skeleton-skeleton-titele"></div>
    </div>

    <div id="content_container">
      <slot />
    </div>
    <div id="whasap_ico" class="fixed right-4 bottom-1/4 z-50 floating-icon">
      <a
        href="https://wa.me/573151569307?text=Hola,%20quiero%20información%20sobre%20sus%20servicios"
        target="_blank"
        rel="noopener noreferrer"
        class="block bg-green-500 p-3 rounded-full shadow-lg hover:bg-green-600 transition-all duration-300 hover:scale-110"
      >
        <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="currentColor">
          <use href="/sprites.svg#whatsapp"></use>
        </svg>
      </a>
    </div>

    <!-- <script src="/script.js" defer></script> -->
    <script>
      import "../components/script.js";
    </script>
  </body>
</html>

<!-- class="fixed right-4 mr-10 top-1/2 -translate-y-1/2 z-50 floating-icon" centra a la
 mitad de la pantalla -->
