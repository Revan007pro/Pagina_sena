---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";

---

<Layout>
 
<main>
       <header class="header">
        <div class="w-full max-w-screen-xl flex justify-between items-center gap-6 text-white bg-sky-950 p-4 rounded-b-lg">
        
        <div class="flex items-center gap-110"> 
            <input type="text" class="w-35 bg-white text-black rounded-3xl" placeholder="Buscar" id="Buscar" />
            <div class="w-20 bg-white text-black flex justify-center hover:bg-cyan-400 rounded-3xl transform transition-transform duration-5 hover:scale-105  object-cover"> 
                <a href="/">Inicio</a>
            </div>
            <div id="theme-switcher" class="z-50 ml-25">
                <button id="theme-toggle" aria-label="Toggle dark-mode">
                    <svg id="moon-icon" class="theme-icon hover:bg-cyan-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>

                    <svg id="sun-icon" class="theme-icon hover:bg-orange-400 hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                </button>
            </div>
        </div>
    </header>

<nav class="mt-15 left-0 w-full flex justify-center py-6 z-50"> 
  <div class="mx-full flex justify-around items-center w-full max-w-145 bg-sky-950 text-white p-4 gap-4 rounded-2xl">
    <a href="/" class="text-center hover:text-gray-400 font-semibold">Inicio</a>
    <a href="/Nosotros" class="text-center hover:text-gray-400 font-semibold">Nosotros</a>
    <a href="/Blog" class="text-center hover:text-gray-400 font-semibold">Blogs</a>
    <a href="http://localhost:4321/Academia" class="text-center hover:text-gray-400 font-semibold">Academia</a>
    
    <li class="relative submenu group cursor-pointer py-2 px-4 rounded-lg transition-colors duration-300 list-none hover:text-gray-400">
      <a href="http://localhost:4321/Servicios">Servicio</a><a class="text-cyan-400 ml-1">⮟</a>
      
      <ul class="menu_especial">
        <li><a href="http://localhost:4321/Abogado" class="block px-4 py-2 hover:bg-cyan-700 rounded">Abogados</a></li>
        <li><a href="http://localhost:4321/Detective" class="block px-4 py-2 hover:bg-cyan-700 rounded">Detectives</a></li>
        <li><a href="http://localhost:4321/Poligrafista" class="block px-4 py-2 hover:bg-cyan-700 rounded">Poligrafistas</a></li>
      </ul>
    </li>
  </div>
</nav>

<div class="flex flex-col items-center py-10 animate-fadeSlideUp">
    <div class="max-w-5xl w-full bg-white py-11 reveal-item transition-all duration-700 ease-out">
        <iframe 
            class="w-full aspect-video"
            src="https://www.youtube.com/embed/-LWc-18rth0"
            title="video promocional"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen>
        </iframe>
        <div class="flex justify-center items-center mt-10">
        <img 
            src="./Imagenes/6.webp" 
            alt="Imagen entera de los servicios de la aplicación web"
            class="w-[480px] h-55 object-cover">
        <p class="text-start mt-0 ml-4 font-special">Equipo A Colombia consultores y Asesores, es una empresa<br>
        Comformada por un equipo multidiciplinario de profesionales dedicados a ofrecer servicios integrales en el ambito<br>
    de derecho penal,altamente capacitado y especializado en cada una de estas áreas,brindando soluciones eficientes<br>
a nuestros clientes<br><br>Contactanos hoy mismo para una consultoria personalizada y descubre como podemos resulver tus<br>
necesidades legales,investigativas y de poligrafia de manera profesional y efectiva</p>
    </div>
    </div>
    
</div>
<div class="relative h-120 flex items-center justify-center text-white text-center 
             bg-[url('./Imagenes/14.webp')] bg-cover bg-center bg-fixed mt-20">
  <div class="absolute inset-0 bg-black opacity-40"><h1 class="text-5xl mt-40">Habla Con Nosotros</h1>
    <div class="cursor-pointer text-2xl mt-7 bg-green-900 w-35 max-w-screen-md mx-auto flex justify-center items-center rounded-3xl
    transform transition-transform duration-5 hover:scale-105">
        <a href="#">WHATSAPP</a></div>
  </div>
  </div>
  <div class="w-full max-w-screen-md mx-auto flex justify-center items-center gap-6 text-white p-4 rounded-b-lg rounded-lg shadow-xl border-gray-300 mt-8">
    <div class="bg-white p-6 rounded-lg">
        <h2 class="text-2xl font-bold mb-4 text-black">Formulario de Contacto</h2>
        <form class="space-y-4">
            <div>
                <label class="block text-gray-700">Nombre de tu Empresa</label>
                <input type="text" class="w-full border-2 p-[7px] drop-shadow-sm px-4 py-2 rounded-md text-black" />
            </div>
            <div>
                <label class="block text-gray-700">Teléfono</label>
                <input type="tel" class="w-full border-2 p-[7px] drop-shadow-sm px-4 py-2 rounded-md text-black" />
            </div>
            <div>
                <label class="block text-gray-700">Email</label>
                <input type="email" class="w-full border-2 p-[7px] drop-shadow-sm px-4 py-2 rounded-md text-black" />
            </div>
            <div>
                <label class="block text-gray-700">Dirección</label>
                <input type="text" class="w-full border-2 p-[7px] drop-shadow-sm px-4 py-2 rounded-md text-black" />
            </div>
        </form>
    </div>
    <div class="w-3xl h-99 bg-gray-300 rounded-md overflow-hidden">
       <iframe 
      class="w-full aspect-video"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2969.589139046039!2d12.491325415730386!3d41.89021027922238!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x132f61e6f1f4b23f%3A0x8f2d5d8e7c1f8a84!2sColosseum!5e0!3m2!1sen!2sit!4v1625488053648!5m2!1sen!2sit" 
      title="video promocional"
      frameborder="0"
      allowfullscreen>
    </iframe>
    </div>
</div>

</div>
        <div class="pt-5"> <div class="grid grid-cols-4 grid-rows-1 gap-20 w-full h-auto mb-4">
                <div class="col-start-2 col-span-3 text-black text-right pr-4">
                    Cree siempre en la verdad
                </div>
            </div>

            <div class="flex justify-end items-center gap-6 bg-sky-950 p-6 w-full mt-8 ">
              
            <a href="https://github.com/Revan007pro" target="_blank">
  <svg class="w-6 h-6 text-white hover:text-gray-300">
    <use href="/sprites.svg#github" />
  </svg>
</a>
<a href="https://youtube.com" target="_blank">
  <svg class="w-6 h-6 text-red-600 hover:text-red-700"> 
    <use href="/sprites.svg#youtube" /> 
  </svg>
</a>


<a href="https://instagram.com" target="_blank">
  <svg class="w-6 h-6 text-pink-600 hover:text-pink-700">
    <use href="/sprites.svg#instagram" />
  </svg>
</a>
</a>
        </div>

        <footer class="w-full text-center py-4 mt-4 text-gray-600">
            <p>Este es el pie de página.</p>
            <p>© 2025 Mi Proyecto. Todos los derechos reservados.</p>
            <a href="#">Ver Terminos y condiciones</a>
        </footer>

    </div>
</main>
</Layout>