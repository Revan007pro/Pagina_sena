---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout>
  <main>
    <header class="header">
      <div
        class="w-full max-w-screen-xl flex justify-between items-center gap-6 text-white bg-sky-950 p-4 rounded-b-lg"
      >
        <div class="flex items-center gap-110">
          <input
            type="text"
            class="w-35 bg-white text-black rounded-3xl"
            placeholder="Buscar"
            id="buscador"
          />
          <div
            class="w-20 bg-white text-black flex justify-center hover:bg-cyan-400 rounded-3xl transform transition-transform duration-5 hover:scale-105 object-cover"
          >
            <a href="/">Inicio</a>
          </div>
          <div id="theme-switcher" class="z-50 ml-25">
            <button id="theme-toggle" aria-label="Toggle dark-mode">
              <svg
                id="moon-icon"
                class="theme-icon hover:bg-cyan-400"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                ></path>
              </svg>

              <svg
                id="sun-icon"
                class="theme-icon hover:bg-orange-400 hidden"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>
    <div id="formulario_citas" class="formulario">
      <h1 class="text-3xl font-bold text-center text-gray-800 mb-8">
        Agendar Cita
      </h1>
      <form id="formCitas" onsubmit="return crearCita()" class="id_formulario">
        <div class="form-group mb-4">
          <label class="text-black block mb-1" for="Nombre_cita">Nombre </label>
          <input
            type="text"
            class="input"
            id="nombre_cita"
            title="Coloque su nombre"
            placeholder="Nombre.."
          />
        </div>
        <div class="form-group mb-4">
          <label class="text-black block mb-1" for="Nombre_cita">Apellido</label
          >
          <input
            type="text"
            class="input"
            id="apellido_cita"
            title="Coloque su Apellido"
            placeholder="Apellido.."
          />
        </div>
        <div class="form-group mb-4">
          <label class="text-black block mb-1" for="Nombre_cita"
            >Documento</label
          >
          <select
            class="input"
            id="tipo_documento"
            title="Coloque su Documento"
          >
            <option value="">Seleccionar una Opcion</option>
            <option value="Cedula">Cedula de Ciudadania</option>
            <option value="D_identidad">Documento de Identidad</option>
            <option value="C_extranjeria">Cedula de Extranjeria</option>
            <option value="PEP">PEP</option>
          </select>
        </div>
        <div class="form-group mb-4">
          <label class="text-black block mb-1" for="Numereo_iden"
            >Numero de Identificación</label
          >
          <input
            type="number"
            class="input"
            id="numero_identidad"
            title="Coloque su Documento"
            placeholder="Documento..."
          />
        </div>
        <div class="form-group mb-4">
          <label class="text-black block mb-1" for="Numereo_iden"
            >Fecha Deseada</label
          >
          <input type="date" class="input" id="fecha_deseada" />
        </div>
        <div class="form-group mb-6">
          <label class="text-black block mb-1" for="especialidad"
            >Especialidad</label
          >
          <select
            class="input"
            id="especialidad"
            name="especialidadEmpleado"
            title="Especialidad del Usuario"
            onchange="listar_empleados(this)"
          >
            <option value="">Selecciona una opción</option>
            <option value="Detective">Detective</option>
            <option value="Poligrafista">Poligrafista</option>
            <option value="Abogado">Abogado</option>
          </select>
        </div>
        <div id="select_empleado"></div>
        <div>
          <div class="justify-center items-center text-center">
            <ul id="mensaje_cita"></ul>
            <button
              id="confirmar_cita"
              type="button"
              class="button"
              onclick="crearCita()"
            >
              Confirmar
            </button>
          </div>
        </div>
      </form>
    </div>
    <div
      class="w-full max-w-screen-md mx-auto flex justify-center items-center gap-6 text-white p-4 rounded-b-lg rounded-lg shadow-xl border-gray-300"
    >
      <div class="bg-white p-6 rounded-lg">
        <h2 class="text-2xl font-bold mb-4 text-black">
          Formulario de Contacto
        </h2>
        <form class="space-y-4">
          <div>
            <label class="block text-gray-700">Nombre de tu Empresa</label>
            <input
              type="text"
              class="w-full border-2 p-[7px] drop-shadow-sm px-4 py-2 rounded-md text-black"
            />
          </div>
          <div>
            <label class="block text-gray-700">Teléfono</label>
            <input
              type="tel"
              class="w-full border-2 p-[7px] drop-shadow-sm px-4 py-2 rounded-md text-black"
            />
          </div>
          <div>
            <label class="block text-gray-700">Email</label>
            <input
              type="email"
              class="w-full border-2 p-[7px] drop-shadow-sm px-4 py-2 rounded-md text-black"
            />
          </div>
          <div>
            <label class="block text-gray-700">Dirección</label>
            <input
              type="text"
              class="w-full border-2 p-[7px] drop-shadow-sm px-4 py-2 rounded-md text-black"
            />
          </div>
          <div>
            <label class="block text-gray-700">Mensaje</label>
            <input
              type="text"
              class="w-full border-2 p-[7px] drop-shadow-sm px-4 py-2 rounded-md text-black"
            />
          </div>
        </form>
      </div>
      <div
        class="w-full mx-auto bg-gray-50 rounded-xl shadow-md overflow-hidden h-[500px] mt-8"
      >
        <Fragment
          set:html={`<iframe
        class="w-full h-115"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3986.1972979500597!2d-76.60902782400156!3d2.441234657094157!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e30030554ee777d%3A0xd3194ddf180ab808!2sCentro%2C%20Popay%C3%A1n%2C%20Cauca!5e0!3m2!1ses-419!2sco!4v1754101169253!5m2!1ses-419!2sco"
        title="Mapa de Popayán"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>`}
        />
      </div>
    </div>
    <div class="pt-5">
      <div class="grid grid-cols-4 grid-rows-1 gap-20 w-full h-auto mb-4">
        <div class="col-start-2 col-span-3 text-black text-right pr-4">
          Cree siempre en la verdad
        </div>
      </div>

      <div
        class="flex justify-end items-center gap-6 bg-sky-950 p-6 w-full mt-8"
      >
        <a href="https://github.com/Revan007pro" target="_blank">
          <svg class="w-6 h-6 text-white hover:text-gray-300">
            <use href="/sprites.svg#github"></use>
          </svg>
        </a>
        <a href="https://youtube.com" target="_blank">
          <svg class="w-6 h-6 text-red-600 hover:text-red-700">
            <use href="/sprites.svg#youtube"></use>
          </svg>
        </a>

        <a href="https://instagram.com" target="_blank">
          <svg class="w-6 h-6 text-pink-600 hover:text-pink-700">
            <use href="/sprites.svg#instagram"></use>
          </svg>
        </a>
      </div>
    </div>

    <footer class="w-full text-center py-4 mt-4 text-gray-600">
      <p>Este es el pie de página.</p>
      <p>© 2025 Mi Proyecto. Todos los derechos reservados.</p>
    </footer>
  </main>
  <script type="module" src="/dasboard_usuario.js" is:inline></script>
</Layout>
