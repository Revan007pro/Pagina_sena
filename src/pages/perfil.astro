---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout>
  <script type="module" src="/scripAdmi.js" is:inline></script>
  <main>
    <header class="fixed top-0 left-0 w-full flex justify-center z-50">
      <div
        class="w-full max-w-screen-xl flex justify-between items-center gap-6 text-white bg-sky-950 p-4 rounded-b-lg"
      >
        <div class="flex items-center gap-110">
          <input
            type="text"
            class="w-35 bg-white text-black rounded-3xl"
            placeholder="Buscar"
            id="Buscar"
          />
          <div
            class="w-20 bg-white text-black flex justify-center hover:bg-cyan-400 rounded-3xl transform transition-transform duration-5 hover:scale-105 object-cover"
          >
            <a href="/">Inicio</a>
          </div>
          <div id="theme-switcher" class="z-50 ml-25">
            <button id="theme-toggle" aria-label="Toggle dark-mode">
              <svg
                id="moon-icon"
                class="theme-icon hover:bg-cyan-400"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                ></path>
              </svg>

              <svg
                id="sun-icon"
                class="theme-icon hover:bg-orange-400 hidden"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                *
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>
    <section class="shadow-sm max-w-md mx-auto w-auto">
      <div class="flex flex-col items-center mt-8 justify-center gap-5">
        <h1 class="mt-4">Perfil del Usuario Seleccionado</h1>
        <label> Identiicador <input class="label-confi" id="idUser" /> </label>

        <label>Nombre <input class="label-confi" id="nombreUser" /></label>
        <label>Apellidos<input class="label-confi" id="apellidosUser" /></label>
        <label
          >Fecha Nacimiento<input class="label-confi" id="fechaUser" /></label
        >
        <label>Roll<input class="label-confi" id="newRoll" /></label>
        <label>Telefono<input class="label-confi" id="telefonoUser" /></label>
        <label>Correo<input class="label-confi" id="correoUser" /></label>
        <label
          >Nueva Contraseña: <input
            class="label-confi"
            id="contraseñaActu"
          /></label
        >
        <label>Estado <label id="estadoUser"></label></label>
        <button onclick="datosConfi()" class="button">Actualizar</button>
      </div>
    </section>

    <div class="pt-5">
      <div class="grid grid-cols-4 grid-rows-1 gap-20 w-full h-auto mb-4">
        <div class="col-start-2 col-span-3 text-black text-right pr-4">
          Cree siempre en la verdad
        </div>
      </div>

      <div
        class="flex justify-end items-center gap-6 bg-sky-950 p-6 w-full mt-8"
      >
        <a href="https://github.com/Revan007pro" target="_blank">
          <svg class="w-6 h-6 text-white hover:text-gray-300">
            <use href="/sprites.svg#github"></use>
          </svg>
        </a>
        <a href="https://youtube.com" target="_blank">
          <svg class="w-6 h-6 text-red-600 hover:text-red-700">
            <use href="/sprites.svg#youtube"></use>
          </svg>
        </a>

        <a href="https://instagram.com" target="_blank">
          <svg class="w-6 h-6 text-pink-600 hover:text-pink-700">
            <use href="/sprites.svg#instagram"></use>
          </svg>
        </a>
      </div>
    </div>
    <footer class="w-full text-center py-4 mt-4 text-gray-600">
      <p>Este es el pie de página.</p>
      <p>© 2025 Mi Proyecto. Todos los derechos reservados.</p>
    </footer>
  </main>
</Layout>
