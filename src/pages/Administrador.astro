---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout>
  <script type="module">
    import { securePage, ingresarUsuario } from "/scripAdmi.js";

    document.addEventListener("DOMContentLoaded", () => {
      securePage();
      ingresarUsuario();
    });
  </script>

  <main class="container mx-auto px-4 py-8">
    <header class="mb-8 flex justify-center items-center">
      <div>
        <h1 class="text-4xl py-5 text-center font-bold">
          Bienvenido al Panel de Control
        </h1>
      </div>
    </header>
    <header class="mb-8 flex justify-end items-center">
      <div
        class="flex justify-center items-center gap-4 w-70 h-auto bg-sky-900 rounded-3xl text-white"
      >
        <div>
          <p>Usuario: <b id="nombreUsuario"></b></p>
          <p>Nombre: <b id="rol_usuario"></b></p>
        </div>
        <div id="btnNotificaciones">
          🔔<span class="bage" id="bage"> </span>
        </div>
        <div id="btnperfil">
          👤 <a class="text-cyan-400 ml-0" id="arrow_admi">⮟</a>
        </div>
        <ul id="bage_admi">
          <li class="hover_empleado">Nombre:</li>
        </ul>
      </div>
      <div id="modal_notificaciones" class="modal">
        <div class="modal-content">
          <h2>Notificaciones</h2>
          <ul id="lista_notificaciones"></ul><button id="cerrar_modal"
            >Cerrar</button
          >
        </div>
      </div>
    </header>

    <div class="flex gap-10 py-10 animate-fadeSlideUp top-0">
      <section>
        <nav id="nav_admi" class="nav_admi">
          <h2
            class="ml-4 py-4 mt-4 rounded-lg transition-colors duration-300 hover:bg-sky-800"
          >
            <button id="_menu" class="hamburguesa"> &#x2261; </button>
            Elementos del <b>administrador</b>
          </h2>

          <ul class="flex flex-col gap-2">
            <li
              class="cursor-pointer py-2 px-4 rounded-lg transition-colors duration-300 hover:bg-sky-800"
            >
              <a href="/Administrador_Academia">Academia</a>
            </li>
            <li
              class="group cursor-pointer py-2 px-4 rounded-lg transition-colors duration-300 hover:bg-sky-800"
            >
              <a href="#">Citas </a><span id="arrow">⮝</span>
              <ul id="subgrupo">
                <li><a href="/Administrador_Abogado">Abogados</a></li>
                <li><a href="/Administrador_Detective">Detectives</a></li>
                <li><a href="/Administrador_Poligrafista">Poligrafistas</a></li>
              </ul>
            </li>
            <li
              class="cursor-pointer py-2 px-4 rounded-lg transition-colors duration-300 hover:bg-sky-800"
            >
              <a href="/Administrador_Usuarios">Usuarios</a>
            </li>
            <li
              class="cursor-pointer py-2 px-4 rounded-lg transition-colors duration-300 hover:bg-sky-800"
            >
              <a href="/Administrador_Usuarios">Gestión de Horarios</a>
            </li>
            <li
              class="flex cursor-pointer py-2 px-4 rounded-lg transition-colors duration-300 hover:bg-sky-800"
            >
              <a href="/Administrador_Blocks"
                >Blocks<span class="bage" id="bage_noti"></span></a
              >
            </li>
          </ul>

          <div
            class="flex justify-center bg-red-600 w-32 h-7 rounded-3xl items-center text-center mt-4 hover:scale-105 transition-transform duration-300"
          >
            <button class="cursor-pointer" onclick="cerrarSeccion()"
              >Cerrar Sesión</button
            >
          </div>
        </nav>
      </section>

      <div id="seccion_class" class="flex-1">
        <section class="seccion_class">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div
              class="rounded-lg shadow-xl border border-gray-200 text-center py-20 font-bold hover:scale-105 transition-transform duration-300"
            >
              <a href="/Administrador_Base_datos"
                >Ver Usuarios Registrados en la página</a
              >
            </div>
            <div
              class="rounded-lg shadow-xl border border-gray-200 text-center py-20 font-bold hover:scale-105 transition-transform duration-300"
            >
              Historial de citas
            </div>
            <div
              class="rounded-lg shadow-xl border border-gray-200 text-center py-20 font-bold hover:scale-105 transition-transform duration-300"
            >
              Administración Academia
            </div>
            <div
              class="rounded-lg shadow-xl border border-gray-200 text-center py-20 font-bold hover:scale-105 transition-transform duration-300"
            >
              Trabajadores registrados en la página
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>
