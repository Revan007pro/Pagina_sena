---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout>
  <script type="module">
    import { securePage, ingresarUsuario } from "/scripAdmi.js";

    // Chart.js initialization would go here if needed, or we use a library via CDN for this demo style
    document.addEventListener("DOMContentLoaded", () => {
      securePage();
      ingresarUsuario();
      
      // Mock interactivity for demo
      const ctx = document.getElementById('salesChart')?.getContext('2d');
      if (ctx && window.Chart) {
        new Chart(ctx, {
          type: 'line',
          data: {
            labels: Array.from({length: 30}, (_, i) => i + 1),
            datasets: [{
              label: 'Ventas por día',
              data: Array.from({length: 30}, () => Math.floor(Math.random() * 100)),
              borderColor: '#2563EB',
              tension: 0.4,
              fill: true,
              backgroundColor: 'rgba(37, 99, 235, 0.1)'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true } }
          }
        });
      }
    });
  </script>

  <!-- External Resources (Icons and Charts for the Dashboard look) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lucide-static@0.321.0/font/lucide.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>

  <div class="min-h-screen bg-[#F8FAFC] flex font-sans text-[#111827]">
    <!-- Menú Lateral -->
    <aside class="w-72 bg-white border-r border-gray-200 hidden lg:flex flex-col sticky top-0 h-screen">
      <div class="p-6 border-b border-gray-100">
        <div class="flex items-center gap-2 text-[#2563EB] font-bold text-xl">
          <i class="lucide-layout-dashboard"></i>
          <span>Panel Admin</span>
        </div>
      </div>
      
      <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
        <div class="px-4 py-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest">General</div>
        <a href="#" class="flex items-center gap-3 px-4 py-3 bg-blue-50 text-[#2563EB] rounded-xl font-medium">
          <i class="lucide-layout-grid w-5"></i> Dashboard
        </a>
        
        <a href="/Administrador_Academia" class="flex items-center gap-3 px-4 py-3 text-[#6B7280] hover:bg-gray-50 rounded-xl transition-colors">
          <i class="lucide-graduation-cap w-5"></i> Academia
        </a>

        <!-- Grupo Citas -->
        <div class="pt-2">
          <div class="px-4 py-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Gestión de Citas</div>
          <div class="space-y-1">
            <a href="/Administrador_Abogado" class="flex items-center gap-3 px-4 py-2 text-[#6B7280] hover:bg-gray-50 rounded-xl transition-colors text-sm">
              <i class="lucide-briefcase w-4"></i> Abogados
            </a>
            <a href="/Administrador_Detective" class="flex items-center gap-3 px-4 py-2 text-[#6B7280] hover:bg-gray-50 rounded-xl transition-colors text-sm">
              <i class="lucide-search w-4"></i> Detectives
            </a>
            <a href="/Administrador_Poligrafista" class="flex items-center gap-3 px-4 py-2 text-[#6B7280] hover:bg-gray-50 rounded-xl transition-colors text-sm">
              <i class="lucide-fingerprint w-4"></i> Poligrafistas
            </a>
          </div>
        </div>

        <div class="pt-2">
          <div class="px-4 py-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Usuarios y Herramientas</div>
          <a href="/Administrador_Usuarios" class="flex items-center gap-3 px-4 py-3 text-[#6B7280] hover:bg-gray-50 rounded-xl transition-colors">
            <i class="lucide-user-plus w-5"></i> Registrar Usuarios
          </a>
          
          <!-- Dropdown Simulado para Gestión -->
          <details class="group">
            <summary class="flex items-center justify-between gap-3 px-4 py-3 text-[#6B7280] hover:bg-gray-50 rounded-xl transition-colors cursor-pointer list-none">
              <div class="flex items-center gap-3">
                <i class="lucide-users w-5"></i> Gestión Usuarios
              </div>
              <i class="lucide-chevron-down w-4 transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="pl-11 pr-4 py-2 space-y-1">
              <a href="/gestion_usuarios" class="block py-2 text-sm text-gray-500 hover:text-blue-600 transition-colors">Usuarios Activos</a>
              <a href="/gestion_inactivos" class="block py-2 text-sm text-gray-500 hover:text-blue-600 transition-colors">Usuarios Inactivos</a>
              <a href="/devolverTool" class="block py-2 text-sm text-gray-500 hover:text-blue-600 transition-colors">Gestión Herramientas</a>
              <a href="/admi_empleados" class="block py-2 text-sm text-gray-500 hover:text-blue-600 transition-colors">Prestar Herramienta</a>
            </div>
          </details>
        </div>

        <div class="pt-2">
          <div class="px-4 py-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Sistema</div>
          <a href="/Administrador_Blocks" class="flex items-center justify-between px-4 py-3 text-[#6B7280] hover:bg-gray-50 rounded-xl transition-colors">
            <div class="flex items-center gap-3">
              <i class="lucide-book-open w-5"></i> Blocks
            </div>
            <span class="bg-blue-100 text-blue-600 text-[10px] px-2 py-0.5 rounded-full font-bold" id="bage_noti">0</span>
          </a>
          <a href="/cambiar_precios" class="flex items-center gap-3 px-4 py-3 text-[#6B7280] hover:bg-gray-50 rounded-xl transition-colors">
            <i class="lucide-tag w-5"></i> Precios
          </a>
        </div>
      </nav>

      <div class="p-4 border-t border-gray-100">
        <button onclick="cerrarSeccion()" class="flex items-center gap-3 px-4 py-3 w-full text-red-500 hover:bg-red-50 rounded-xl transition-colors font-medium">
          <i class="lucide-log-out w-5"></i> Cerrar Sesión
        </button>
      </div>
    </aside>

    <!-- Contenido Principal -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <!-- Barra Superior -->
      <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-4 lg:px-8 sticky top-0 z-10">
        <div class="flex items-center gap-4 flex-1">
          <button class="lg:hidden text-gray-500">
            <i class="lucide-menu"></i>
          </button>
          <div class="relative w-full max-w-md hidden md:block">
            <i class="lucide-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-4"></i>
            <input type="text" placeholder="Buscar..." class="w-full bg-[#F8FAFC] border-none rounded-lg py-2 pl-10 pr-4 focus:ring-2 focus:ring-blue-500 text-sm" />
          </div>
        </div>

        <div class="flex items-center gap-2 lg:gap-6">
          <div class="hidden sm:flex items-center gap-2 bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-1.5 text-xs font-medium text-gray-600">
            <i class="lucide-calendar w-4"></i>
            <span>Últimos 30 días</span>
          </div>
          
          <button class="relative text-gray-500 hover:text-blue-600 transition-colors">
            <i class="lucide-bell w-6"></i>
            <span class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] w-4 h-4 flex items-center justify-center rounded-full border-2 border-white">3</span>
          </button>

          <div class="h-8 w-px bg-gray-200 hidden sm:block"></div>

          <div class="flex items-center gap-3 group relative cursor-pointer" id="btnperfil">
            <div class="text-right hidden sm:block">
              <p class="text-sm font-semibold text-[#111827]" id="nombreUsuario">Admin</p>
              <p class="text-[10px] text-[#6B7280] uppercase tracking-wider font-bold" id="rol_usuario">Administrador General</p>
            </div>
            
            <!-- Contenedor del Avatar con "Ruedita" de edición -->
            <div class="relative">
              <div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold border-2 border-white shadow-sm overflow-hidden">
                <i class="lucide-user w-6"></i>
              </div>
              <!-- Ruedita/Icono de edición para la imagen -->
              <div class="absolute -bottom-1 -right-1 bg-white shadow-sm border border-gray-200 rounded-full p-1 text-[#6B7280] hover:text-blue-600 transition-colors">
                <i class="lucide-camera w-3 h-3"></i>
              </div>
            </div>

            <!-- El "nav invisible" original (Menú Desplegable Estilizado) -->
            <ul id="bage_admi" class="absolute right-0 top-full mt-2 w-48 bg-white border border-gray-100 rounded-xl shadow-xl py-2 hidden group-hover:block z-50 animate-fadeSlideUp">
              <li class="px-4 py-2 border-b border-gray-50 mb-1">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Información</p>
                <p id="correo_bage" class="text-xs text-gray-600 truncate"></p>
                <p id="telefono_bage" class="text-xs text-gray-600"></p>
              </li>
              <li>
                <button type="button" onclick="confiPage()" id="confi" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors flex items-center gap-2">
                  <i class="lucide-settings w-4"></i> Configurar
                </button>
              </li>
              <li>
                <a href="/perfil" class="block px-4 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors flex items-center gap-2">
                  <i class="lucide-user-circle w-4"></i> Perfil
                </a>
              </li>
              <li class="mt-1 pt-1 border-t border-gray-50">
                <button type="button" onclick="cerrarSeccion()" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors flex items-center gap-2 font-medium">
                  <i class="lucide-log-out w-4"></i> Cerrar Sesión
                </button>
              </li>
            </ul>
          </div>
        </div>
      </header>

      <!-- Dashboard Body -->
      <main class="flex-1 overflow-y-auto p-4 lg:p-8 space-y-8">
        <!-- Header del Dashboard -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold text-[#111827]">Panel de Control</h1>
            <p class="text-[#6B7280] text-sm">Bienvenido de nuevo. Aquí tienes el resumen de hoy.</p>
          </div>
          <div class="flex items-center gap-3">
            <button class="bg-white border border-gray-200 text-gray-700 px-4 py-2 rounded-xl text-sm font-medium hover:bg-gray-50 transition-colors flex items-center gap-2">
              <i class="lucide-download w-4"></i> Exportar
            </button>
            <button class="bg-[#2563EB] text-white px-4 py-2 rounded-xl text-sm font-medium hover:bg-blue-700 transition-shadow shadow-lg shadow-blue-200 flex items-center gap-2">
              <i class="lucide-plus w-4"></i> Nuevo Reporte
            </button>
          </div>
        </div>

        <!-- KPIs Principales -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- KPI 1 -->
          <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-4">
              <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
                <i class="lucide-dollar-sign w-6"></i>
              </div>
              <span class="text-green-500 text-xs font-bold bg-green-50 px-2 py-1 rounded-full flex items-center gap-1">
                <i class="lucide-trending-up w-3"></i> 12.5%
              </span>
            </div>
            <p class="text-[#6B7280] text-sm font-medium">Ingresos Totales</p>
            <h3 class="text-2xl font-bold mt-1">$45,231.89</h3>
          </div>

          <!-- KPI 2 -->
          <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-4">
              <div class="p-2 bg-emerald-50 text-emerald-600 rounded-lg">
                <i class="lucide-shopping-bag w-6"></i>
              </div>
              <span class="text-green-500 text-xs font-bold bg-green-50 px-2 py-1 rounded-full flex items-center gap-1">
                <i class="lucide-trending-up w-3"></i> 8.2%
              </span>
            </div>
            <p class="text-[#6B7280] text-sm font-medium">Ventas del Mes</p>
            <h3 class="text-2xl font-bold mt-1">+2,350</h3>
          </div>

          <!-- KPI 3 -->
          <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-4">
              <div class="p-2 bg-sky-50 text-sky-600 rounded-lg">
                <i class="lucide-users w-6"></i>
              </div>
              <span class="text-blue-500 text-xs font-bold bg-blue-50 px-2 py-1 rounded-full flex items-center gap-1">
                <i class="lucide-trending-up w-3"></i> 15%
              </span>
            </div>
            <p class="text-[#6B7280] text-sm font-medium">Nuevos Clientes</p>
            <h3 class="text-2xl font-bold mt-1" id="numberUser">1,240</h3>
          </div>

          <!-- KPI 4 -->
          <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-4">
              <div class="p-2 bg-amber-50 text-amber-600 rounded-lg">
                <i class="lucide-clock w-6"></i>
              </div>
              <span class="text-amber-500 text-xs font-bold bg-amber-50 px-2 py-1 rounded-full flex items-center gap-1">
                 Activo
              </span>
            </div>
            <p class="text-[#6B7280] text-sm font-medium">Órdenes Pendientes</p>
            <h3 class="text-2xl font-bold mt-1">48</h3>
          </div>
        </div>

        <!-- Seccion Central: Grafico y Panel Lateral -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Gráfico de Ventas -->
          <div class="lg:col-span-2 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-6">
              <h3 class="font-bold text-lg">Resumen de Ventas</h3>
              <select class="text-xs bg-[#F8FAFC] border border-gray-200 rounded-lg px-2 py-1 outline-none">
                <option>Últimos 30 días</option>
                <option>Últimos 7 días</option>
              </select>
            </div>
            <div class="h-80 w-full">
              <canvas id="salesChart"></canvas>
            </div>
          </div>

          <!-- Panel Lateral de Actividad/Alertas -->
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
              <h3 class="font-bold text-lg mb-4">Alertas Críticas</h3>
              <div class="space-y-4">
                <div class="flex gap-3 items-start p-3 bg-red-50 rounded-xl">
                  <div class="p-2 bg-red-100 text-red-600 rounded-lg shrink-0">
                    <i class="lucide-alert-triangle w-4"></i>
                  </div>
                  <div>
                    <p class="text-sm font-bold text-red-900">Stock bajo</p>
                    <p class="text-xs text-red-700">5 productos están por debajo del mínimo.</p>
                  </div>
                </div>
                <div class="flex gap-3 items-start p-3 bg-amber-50 rounded-xl">
                  <div class="p-2 bg-amber-100 text-amber-600 rounded-lg shrink-0">
                    <i class="lucide-file-warning w-4"></i>
                  </div>
                  <div>
                    <p class="text-sm font-bold text-amber-900">Facturas vencidas</p>
                    <p class="text-xs text-amber-700">Hay 12 pagos pendientes de revisión.</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
              <h3 class="font-bold text-lg mb-4">Últimas Órdenes</h3>
              <div class="space-y-4">
                {[1, 2, 3].map((_) => (
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-xs font-bold text-gray-500">JD</div>
                      <div>
                        <p class="text-xs font-bold">Juan Delgado</p>
                        <p class="text-[10px] text-gray-500">Hace 5 min</p>
                      </div>
                    </div>
                    <span class="text-xs font-bold text-[#2563EB]">$120.00</span>
                  </div>
                ))}
              </div>
              <button class="w-full mt-4 text-xs font-bold text-blue-600 hover:underline">Ver todas</button>
            </div>
          </div>
        </div>

        <!-- Tabla de Actividad Reciente -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-gray-50 flex items-center justify-between">
            <h3 class="font-bold text-lg">Actividad Reciente</h3>
            <button class="text-sm text-blue-600 font-medium hover:bg-blue-50 px-3 py-1 rounded-lg transition-colors">Ver historial</button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-[#F8FAFC] text-[#6B7280] text-xs uppercase tracking-wider font-semibold">
                  <th class="px-6 py-4">Fecha</th>
                  <th class="px-6 py-4">Cliente</th>
                  <th class="px-6 py-4">Producto</th>
                  <th class="px-6 py-4">Total</th>
                  <th class="px-6 py-4">Estado</th>
                  <th class="px-6 py-4">Método de pago</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-50 text-sm">
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-500">28 Jul, 2026</td>
                  <td class="px-6 py-4 font-medium">Carlos Ruiz</td>
                  <td class="px-6 py-4 text-gray-600">Suscripción Pro</td>
                  <td class="px-6 py-4 font-bold">$29.99</td>
                  <td class="px-6 py-4">
                    <span class="bg-green-100 text-green-700 px-2 py-1 rounded-full text-[10px] font-bold uppercase">Completado</span>
                  </td>
                  <td class="px-6 py-4 text-gray-500 flex items-center gap-2">
                    <i class="lucide-credit-card w-4"></i> Visa **** 4242
                  </td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-500">28 Jul, 2026</td>
                  <td class="px-6 py-4 font-medium">Ana Beltrán</td>
                  <td class="px-6 py-4 text-gray-600">Curso Diseño UX</td>
                  <td class="px-6 py-4 font-bold">$150.00</td>
                  <td class="px-6 py-4">
                    <span class="bg-amber-100 text-amber-700 px-2 py-1 rounded-full text-[10px] font-bold uppercase">Pendiente</span>
                  </td>
                  <td class="px-6 py-4 text-gray-500 flex items-center gap-2">
                    <i class="lucide-wallet w-4"></i> PayPal
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Indicadores Rápidos -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
           <div class="bg-white p-4 rounded-xl border border-gray-100 text-center space-y-1">
             <p class="text-[10px] text-gray-500 font-bold uppercase">Usuarios Activos</p>
             <h4 class="text-lg font-bold">854</h4>
           </div>
           <div class="bg-white p-4 rounded-xl border border-gray-100 text-center space-y-1">
             <p class="text-[10px] text-gray-500 font-bold uppercase">Tickets Abiertos</p>
             <h4 class="text-lg font-bold">14</h4>
           </div>
           <div class="bg-white p-4 rounded-xl border border-gray-100 text-center space-y-1">
             <p class="text-[10px] text-gray-500 font-bold uppercase">Pagos Pendientes</p>
             <h4 class="text-lg font-bold">3</h4>
           </div>
           <div class="bg-white p-4 rounded-xl border border-gray-100 text-center space-y-1">
             <p class="text-[10px] text-gray-500 font-bold uppercase">Facturas Vencidas</p>
             <h4 class="text-lg font-bold text-red-500">2</h4>
           </div>
           <div class="bg-white p-4 rounded-xl border border-gray-100 text-center space-y-1">
             <p class="text-[10px] text-gray-500 font-bold uppercase">Objetivos</p>
             <h4 class="text-lg font-bold">92%</h4>
           </div>
           <div class="bg-white p-4 rounded-xl border border-gray-100 text-center space-y-1">
             <p class="text-[10px] text-gray-500 font-bold uppercase">NPS</p>
             <h4 class="text-lg font-bold text-green-600">78</h4>
           </div>
        </div>
      </main>
    </div>
  </div>

  <style>
    /* Custom Scrollbar for better UX */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #E2E8F0;
      border-radius: 10px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #CBD5E1;
    }
  </style>
</Layout>
