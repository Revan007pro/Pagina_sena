---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import "../styles/style.less";
---

<Layout>
  <main class="w-full h-screen flex flex-col items-center justify-center px-4">
    <header class="fixed top-0 left-0 w-full flex justify-center z-50">
      <div
        class="w-full max-w-screen-xl flex justify-between items-center gap-6 text-white bg-sky-950 p-4 rounded-b-lg"
      >
        <div class="flex items-center gap-110">
          <input
            type="text"
            class="w-35 bg-white text-black rounded-3xl"
            placeholder="Buscar"
            id="Buscar"
          />
          <div
            class="w-20 bg-white text-black flex justify-center hover:bg-cyan-400 rounded-3xl transform transition-transform duration-5 hover:scale-105 object-cover"
          >
            <a href="http://localhost:4321/">Inicio</a>
          </div>
          <div id="theme-switcher" class="z-50 ml-25">
            <button id="theme-toggle" aria-label="Toggle dark-mode">
              <svg
                id="moon-icon"
                class="theme-icon hover:bg-cyan-400"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                ></path>
              </svg>

              <svg
                id="sun-icon"
                class="theme-icon hover:bg-orange-400 hidden"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
            </button>
          </div>
        </div>
      </div>
      <div
        class="max-w-sm w-full text-gray-600 space-y-5 bg-white p-8 rounded-lg shadow-xl border border-gray-200"
      >
        <div class="text-center pb-6">
          <div class="mt-5">
            <h1 class="text-gray-800 text-3xl font-bold">Iniciar Sesión</h1>
          </div>
        </div>

        <form
          action="#"
          method="POST"
          class="space-y-6"
          onsubmit="ingresarUsuario()"
        >
          <div>
            <label for="usuario">Usuario</label>
            <input
              type="text"
              id="usuario"
              name="usuario"
              required
              class="input-user"
              placeholder="tu_email@ejemplo.com"
            />
          </div>

          <div>
            <label
              for="password"
              class="grid grid-cols-1 text-sm font-medium text-gray-700 mb-1"
            >
              Contraseña
            </label>

            <input
              type="password"
              id="password"
              name="password"
              required
              class="input-user"
              placeholder="********"
            />
            <button type="button" id="show">🙉</button>
            <button type="button" id="hide">🙈</button>
          </div>

          <div class="flex items-center justify-between text-sm">
            <div class="flex items-center gap-x-2">
              <input
                type="checkbox"
                id="recordar_contraseña"
                name="remember_me"
                class="h-4 w-4 text-sky-600 focus:ring-sky-500 border-gray-300 rounded"
              />

              <label for="remember-me-checkbox" class="text-gray-600"
                >Recordarme</label
              >
            </div>
            <a
              href="/olvide-contrasena"
              class="text-center text-sky-600 hover:text-sky-500 font-medium"
            >
              ¿Olvidaste tu contraseña?
            </a>
          </div>
          <div>
            <input type="radio" />Recordar contraseña
          </div>
        </form>

        <div>
          <button type="button" class="button" onclick="ingresarUsuario()">
            Iniciar Sesión
          </button>
        </div>

        <button
          class="w-full flex items-center justify-center gap-x-3 py-2.5 border border-gray-300 rounded-lg text-sm font-medium hover:bg-gray-50 duration-150 active:bg-gray-100 text-gray-700 shadow-sm"
          onclick="loginUsuario_google()"
        >
          <img
            src="https://www.svgrepo.com/show/303108/google-icon-logo.svg"
            alt="Google logo"
            class="w-5 h-5"
          />
          Continuar con Google
        </button>
        <div>
          <button class="button"
            ><a href="/Agendar_Citas">Agendar Cita</a></button
          >
        </div>
      </div>

      <p class="text-center text-gray-600 text-sm">
        ¿No tienes una cuenta?
        <a
          href="/Registrarse"
          class="font-medium text-sky-600 hover:text-sky-500"
        >
          Regístrate
        </a>
      </p>
    </header>
  </main>
  <script type="module">
    import { ingresarUsuario } from "/scripAdmi.js";

    const btn = document.getElementById("btn-login");

    btn.addEventListener("click", () => {
      ingresarUsuario(); //añade un evento click para poder usar el script en el scope
    });
  </script>
</Layout>
