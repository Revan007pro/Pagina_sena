---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout>
  <main>
    <header class="header">
      <div
        class="w-full max-w-screen-xl flex justify-between items-center gap-6 text-white bg-sky-950 p-4 rounded-b-lg"
      >
        <div class="flex items-center gap-110">
          <input
            type="text"
            class="w-35 bg-white text-black rounded-3xl"
            placeholder="Buscar"
            id="buscador"
          />
          <div
            class="w-20 bg-white text-black flex justify-center hover:bg-cyan-400 rounded-3xl transform transition-transform duration-5 hover:scale-105 object-cover"
          >
            <a href="/">Inicio</a>
          </div>
          <div id="theme-switcher" class="z-50 ml-25">
            <button id="theme-toggle" aria-label="Toggle dark-mode">
              <svg
                id="moon-icon"
                class="theme-icon hover:bg-cyan-400"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                ></path>
              </svg>

              <svg
                id="sun-icon"
                class="theme-icon hover:bg-orange-400 hidden"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>
    <nav class="mt-15 left-0 w-full flex justify-center py-6 z-50 buscable">
      <div
        class="mx-full flex justify-around items-center w-full max-w-145 bg-sky-950 text-white p-4 gap-4 rounded-2xl"
      >
        <a href="/" class="text-center hover:text-gray-400 font-semibold"
          >Inicio</a
        >
        <a
          href="/Nosotros.html"
          class="text-center hover:text-gray-400 font-semibold">Nosotros</a
        >
        <a
          href="/Blog.html"
          class="text-center hover:text-gray-400 font-semibold">Blog</a
        >
        <a
          href="/Academia.html"
          class="text-center hover:text-gray-400 font-semibold">Academia</a
        >

        <li
          class="relative submenu group cursor-pointer py-2 px-4 rounded-lg transition-colors duration-300 list-none hover:text-gray-400"
        >
          <a href="/Servicios.html">Servicio</a><a class="text-cyan-400 ml-1"
            >⮟</a
          >

          <ul class="menu_especial">
            <li>
              <a
                href="/Abogado.html"
                class="block px-4 py-2 hover:bg-cyan-700 rounded">Abogados</a
              >
            </li>
            <li>
              <a
                href="/Detective.html"
                class="block px-4 py-2 hover:bg-cyan-700 rounded">Detectives</a
              >
            </li>
            <li>
              <a
                href="/Poligrafista.html"
                class="block px-4 py-2 hover:bg-cyan-700 rounded"
                >Poligrafistas</a
              >
            </li>
          </ul>
        </li>
      </div>
    </nav>
    <div class="formulario">
      <form class="id_formulario">
        <div class="form-group mb-4">
          <label>Identificación Cita</label>
        </div>
        <div class="form-group mb-4">
          <label id="idCitaRepo"></label>
        </div>
        <div class="form-group mb-4">
          <label>Ingrese Fecha a reprogramar</label>
        </div>
        <div class="form-group mb-4">
          <input id="fechaRepo" type="date" id="repoFe" />
        </div>
        <div class="form-group mb-4">
          <label>Hora Deseada a reprogramar</label>
        </div>
        <!-- <div class="form-group mb-4">
          <input
            class="w-50 input"
            placeholder="hh:mm"
            class="input"
            id="horaRepro"
          />
        </div> -->
        <div id="horaRepo"></div>
        <div class="form-group mb-4">
          <button type="button" onclick="reprogramarCita()" class="button"
            >Confirmar</button
          >
        </div>
        <div class="form-group mb-4">
          <button type="button" class="button" onclick="verHorarioEmpleado()"
            >Cancelar</button
          >
        </div>
      </form>
    </div>
    <script type="module" src="/reprogramar_cita.js" is:inline></script>
  </main></Layout
>
